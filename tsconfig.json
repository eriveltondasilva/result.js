{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "docs", "tests", "**/*.spec.ts", "**/*.test.ts"]
}
