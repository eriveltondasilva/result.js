{
  "name": "@eriveltonsilva/result.js",
  "version": "1.2.2",
  "description": "A lightweight, Rust-inspired Result type for JavaScript and TypeScript — handle success and error cases without exceptions.",
  "keywords": [
    "javascript",
    "typescript",
    "result-type",
    "rust",
    "monad",
    "functional programming",
    "error handling"
  ],
  "homepage": "https://eriveltondasilva.github.io/result.js/",
  "bugs": {
    "url": "https://github.com/eriveltondasilva/result.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriveltondasilva/result.js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Erivelton Silva",
    "email": "eriveltondasilva13@gmail.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsup",
    "clean": "rimraf dist",
    "predocs:build": "node scripts/copy-changelog.js && typedoc",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs --open",
    "docs:preview": "vitepress preview docs",
    "fix": "bun run types && bun run lint:fix && bun run fmt:fix",
    "fmt": "bunx prettier . --check",
    "fmt:fix": "bunx prettier . --write --cache",
    "lint": "bunx --bun eslint .",
    "lint:fix": "bunx eslint . --fix --cache",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "types": "tsc --noEmit",
    "postversion": "git push origin main --follow-tags"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.12",
    "husky": "^9.1.7",
    "publint": "^0.3.18",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
