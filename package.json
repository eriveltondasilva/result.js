{
  "name": "@eriveltondasilva/result.js",
  "version": "1.0.0",
  "description": "A lightweight, Rust-inspired Result type for JavaScript and TypeScript — handle success and error cases without exceptions.",
  "keywords": [
    "result.js",
    "result",
    "monad",
    "rust",
    "rusty",
    "rust-like",
    "functional programming",
    "error handling"
  ],
  "homepage": "https://eriveltondasilva.github.io/result.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriveltondasilva/result.js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Erivelton Silva",
    "email": "eriveltondasilva13@gmail.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "bun run clean && tsup",
    "clean": "bun run --bun rm -rf dist",
    "prepublishOnly": "NODE_ENV=production bun run build",
    "postversion": "git push origin main --follow-tags",
    "1xxx": "",
    "predocs:build": "bun run scripts/copy-changelog.ts && bunx typedoc",
    "docs:build": "bunx vitepress build docs",
    "docs:dev": "bunx vitepress dev docs --open",
    "docs:preview": "bunx vitepress preview docs",
    "2xxx": "",
    "fmt": "bunx --bun @biomejs/biome format .",
    "fmt:fix": "bunx --bun @biomejs/biome format --write .",
    "lint": "bunx --bun @biomejs/biome lint .",
    "lint:fix": "bunx --bun @biomejs/biome lint --write .",
    "check": "bunx --bun @biomejs/biome check .",
    "check:fix": "bunx --bun @biomejs/biome check --write .",
    "check:ci": "bunx --bun @biomejs/biome ci .",
    "3xxx": "",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "4xxx": "",
    "types": "tsc --noEmit -p tsconfig.json",
    "dev": "bun run types && bun run check:fix && bun run test",
    "init:husky": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": "bunx --bun @biomejs/biome check --write --no-errors-on-unmatched"
  }
}
